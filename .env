# Theme tools (theme switcher button + terminal `theme` command).
#
# false (default, and what GitHub Actions builds with): themes are route-based only.
#   /npro           -> Signal
#   /npro/microsoft -> Microsoft (the session is then locked to that company)
#
# true: show the switcher and the `theme` command so you can move between themes while developing.
#
# A variable that already exists in the environment beats this file, so on your dev machine
# set a Windows user variable and restart the terminal / dev server:
#   setx VITE_THEME_SWITCHER true
# To turn it off again:
#   setx VITE_THEME_SWITCHER ""      (or delete the variable in "Edit environment variables")
#
# You can also unlock at runtime from the browser DevTools console: npro.unlockThemes()
VITE_THEME_SWITCHER=false
